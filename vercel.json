{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/smtp/send", "destination": "/api/smtp/send" },
    { "source": "/api/smtp/test", "destination": "/api/smtp/test" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/.*).*)", "destination": "/index.html" }
  ]
}
