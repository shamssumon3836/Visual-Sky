{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile stored in Firestore.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "maxLength": 254
        },
        "name": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 120
        },
        "avatar": {
          "type": "string",
          "description": "Profile photo URL",
          "maxLength": 1024
        },
        "role": {
          "type": "string",
          "enum": ["client", "agency"],
          "description": "Workspace role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "email", "name", "role", "createdAt", "updatedAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Cross-device and cross-browser synchronized workspace and AI Outreach Copilot session state.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Owner email address"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "aiChatSessions": {
          "type": "array",
          "description": "AI Outreach Copilot conversation sessions"
        },
        "aiActiveSessionId": {
          "type": "string",
          "description": "Active AI Outreach Copilot session ID"
        },
        "permanentlyDeletedIds": {
          "type": "array",
          "description": "Tombstone IDs for permanently deleted items"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last workspace update"
        }
      },
      "required": ["updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile documents keyed by Firebase Auth UID"
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Workspace and AI Copilot sync documents keyed by canonical workspace ID"
    }
  }
}
