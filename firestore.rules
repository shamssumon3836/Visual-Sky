rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'rafiqulvisualsky@gmail.com' ||
        request.auth.token.email == 'sojibdaridro123@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'email', 'name', 'avatar', 'role', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1024)) &&
             data.role in ['client', 'agency'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
                    isValidId(userId) &&
                    request.auth.uid == userId &&
                    isValidUserProfile(incoming()) &&
                    incoming().uid == request.auth.uid &&
                    incoming().email == request.auth.token.email &&
                    (incoming().role == 'client' || isAdmin()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
                    isValidId(userId) &&
                    isValidUserProfile(incoming()) &&
                    (
                      isAdmin() ||
                      (
                        request.auth.uid == userId &&
                        incoming().uid == existing().uid &&
                        incoming().email == existing().email &&
                        incoming().role == existing().role &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().updatedAt == request.time &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'updatedAt'])
                      )
                    );

      allow delete: if isAdmin();
    }
  }
}
