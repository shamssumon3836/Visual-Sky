          <span>←</span>
          <span class="hidden sm:inline">Back to Dashboard</span>
        </a>
        <div class="h-4 w-px bg-slate-800 hidden sm:block"></div>
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center font-black text-white text-base shadow-md shadow-cyan-500/30">
            ⚡
          </div>
          <div>
            <h1 class="text-sm sm:text-base font-extrabold tracking-tight text-white flex items-center gap-2">
              <span>7-Day Autonomous Outreach Engine</span>
            </h1>
            <p class="text-[11px] text-slate-400 hidden md:block">Real Database Senders &bull; Multi-Niche Rotator &bull; Mobile Push Hub</p>
