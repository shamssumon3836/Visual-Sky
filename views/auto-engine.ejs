            class="w-full py-2.5 rounded-xl border border-dashed border-cyan-500/40 hover:border-cyan-400 text-cyan-300 hover:text-white text-xs font-bold transition flex items-center justify-center gap-2 bg-cyan-500/5 hover:bg-cyan-500/10 cursor-pointer"
