  <!-- ========================================================================= -->
  <!-- MODAL: CONNECT NEW CUSTOM SMTP SENDER -->
  <!-- ========================================================================= -->
  <div id="smtp-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4 hidden">
    <div class="w-full max-w-lg rounded-3xl bg-[#090e1c] border border-cyan-500/40 p-6 sm:p-7 shadow-2xl relative space-y-5 animate-in fade-in zoom-in-95 duration-200">
      
      <!-- Modal Header -->
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold">
            ✉️
          </div>
          <div>
            <h3 class="text-base font-black text-white">Connect New SMTP Sender</h3>
            <p class="text-xs text-slate-400">Verifies live credentials via nodemailer.verify() before saving</p>
          </div>
        </div>
        <button
          type="button"
          id="btn-close-smtp-modal"
          class="text-slate-400 hover:text-white p-1 text-lg font-bold"
        >
          &times;
        </button>
      </div>

      <!-- Modal Form -->
      <form id="smtp-form" class="space-y-3.5">
        
        <!-- Sender Email -->
        <div class="space-y-1">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-300">Sender Email Address *</label>
          <input
            type="email"
            id="smtp-field-email"
            required
            placeholder="outreach@yourdomain.com"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs sm:text-sm text-white focus:outline-none focus:border-cyan-500 transition"
          >
        </div>

        <!-- Host and Port -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="sm:col-span-2 space-y-1">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300">SMTP Host *</label>
            <input
              type="text"
              id="smtp-field-host"
              required
              placeholder="smtp.gmail.com or mail.yourdomain.com"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs sm:text-sm text-white focus:outline-none focus:border-cyan-500 transition"
            >
          </div>

          <div class="space-y-1">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300">Port *</label>
            <input
              type="number"
              id="smtp-field-port"
              required
              value="587"
              placeholder="587 or 465"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs sm:text-sm text-cyan-300 font-bold focus:outline-none focus:border-cyan-500 transition"
            >
          </div>
        </div>

        <!-- Username and Password -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300">Username *</label>
            <input
              type="text"
              id="smtp-field-user"
              required
              placeholder="Username or email"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs sm:text-sm text-white focus:outline-none focus:border-cyan-500 transition"
            >
          </div>

          <div class="space-y-1">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300">Password / App Password *</label>
            <input
              type="password"
              id="smtp-field-pass"
              required
              placeholder="••••••••••••"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs sm:text-sm text-white focus:outline-none focus:border-cyan-500 transition"
            >
          </div>
        </div>

        <!-- Daily Limit -->
        <div class="space-y-1">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-300">Daily Limit per Sender</label>
          <input
            type="number"
            id="smtp-field-limit"
            required
            min="5"
            max="200"
            value="30"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs sm:text-sm text-cyan-300 font-bold focus:outline-none focus:border-cyan-500 transition"
          >
          <p class="text-[11px] text-slate-400">Default 30 emails/day recommended for high inbox delivery.</p>
        </div>

        <!-- Modal Action Buttons -->
        <div class="pt-3 flex items-center justify-end gap-2.5">
          <button
            type="button"
            id="btn-cancel-smtp"
            class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 text-xs font-bold transition cursor-pointer"
          >
            Cancel
          </button>

          <button
            type="submit"
            id="btn-test-save-smtp"
            class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-slate-950 font-black text-xs shadow-lg shadow-emerald-500/20 transition flex items-center gap-1.5 cursor-pointer disabled:opacity-50"
          >
            <span>⚡</span>
            <span id="btn-save-smtp-text">Test & Save SMTP</span>
          </button>
        </div>

      </form>

    </div>
  </div>

  <!-- Client-Side JavaScript Logic -->
  <script>
    let activePushSubscription = null;

    // Toast Utility
    function displayToast(msg, type = 'info') {
      const box = document.getElementById('push-feedback-message');
      box.classList.remove('hidden', 'border-rose-500/50', 'text-rose-300', 'border-emerald-500/50', 'text-emerald-300', 'border-cyan-500/50', 'text-cyan-300');
      
      if (type === 'error') {
        box.classList.add('border-rose-500/50', 'text-rose-300');
      } else if (type === 'success') {
        box.classList.add('border-emerald-500/50', 'text-emerald-300');
      } else {
        box.classList.add('border-cyan-500/50', 'text-cyan-300');
      }
      
      box.textContent = msg;
      box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Modal Controls
    const modal = document.getElementById('smtp-modal');
    const openModal = () => modal.classList.remove('hidden');
    const closeModal = () => modal.classList.add('hidden');

    document.getElementById('btn-open-smtp-modal').onclick = openModal;
    document.getElementById('btn-add-sender-card').onclick = openModal;
    document.getElementById('btn-close-smtp-modal').onclick = closeModal;
    document.getElementById('btn-cancel-smtp').onclick = closeModal;

    // Load & Render Connected Senders Health from Database
    async function loadConnectedSenders() {
      const listContainer = document.getElementById('senders-health-list');
      try {
        const res = await fetch('/api/auto-campaign/senders');
        const data = await res.json();

        if (data.success && Array.isArray(data.senders) && data.senders.length > 0) {
          listContainer.innerHTML = data.senders.map(s => {
            const limit = s.dailyLimit || 30;
            const sent = s.sentToday || 0;
            const pct = Math.min(100, Math.round((sent / limit) * 100));
            return `
              <div class="p-3 rounded-2xl bg-slate-950/90 border border-slate-800/80 space-y-1.5 transition hover:border-slate-700">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs font-bold text-white truncate">${s.email}</span>
                  <div class="flex items-center gap-1.5 shrink-0">
                    <span class="px-2 py-0.5 rounded text-[9px] font-black bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                      ${s.status || 'Active 🟢'}
                    </span>
                    <button
                      type="button"
                      onclick="deleteSenderAccount('${s.email}')"
                      class="px-1.5 py-0.5 rounded text-[10px] text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 font-bold transition"
                      title="Disconnect sender"
                    >
                      ✕
                    </button>
                  </div>
                </div>
                <div class="flex items-center justify-between text-[11px] text-slate-400">
                  <span>Quota: <strong class="text-slate-200">${sent} / ${limit}</strong> Sent</span>
                  <span>Warmup: <strong class="text-cyan-400">${s.warmupScore || '100%'}</strong></span>
                </div>
                <div class="w-full bg-slate-900 rounded-full h-1.5 overflow-hidden">
                  <div class="bg-gradient-to-r from-emerald-500 via-teal-400 to-cyan-500 h-1.5 rounded-full transition-all" style="width: ${pct}%"></div>
                </div>
              </div>
            `;
          }).join('');
        } else {
          listContainer.innerHTML = `
            <div class="p-6 text-center rounded-2xl bg-slate-950/50 border border-slate-800/60 space-y-2">
              <p class="text-xs font-semibold text-slate-400">No Custom SMTP Senders Connected Yet</p>
              <p class="text-[11px] text-slate-500">Connect your custom sending mailboxes to start the 7-day automated engine.</p>
              <button
                type="button"
                onclick="document.getElementById('smtp-modal').classList.remove('hidden')"
                class="px-3.5 py-1.5 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs font-bold transition"
              >
                + Connect First SMTP Sender
              </button>
            </div>
          `;
        }
      } catch (err) {
        listContainer.innerHTML = `
          <div class="p-4 text-center text-rose-400 text-xs">Failed to load sender accounts from database.</div>
        `;
      }
    }

    // Delete Sender Account
    async function deleteSenderAccount(email) {
      if (!confirm(`Are you sure you want to disconnect and delete sender "${email}"?`)) return;
      try {
        const res = await fetch('/api/auto-campaign/delete-sender', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await res.json();
        if (data.success) {
          displayToast(`Sender "${email}" removed successfully.`, 'info');
          loadConnectedSenders();
        } else {
          displayToast(data.error || 'Failed to remove sender.', 'error');
        }
      } catch {
        displayToast('Network error removing sender.', 'error');
      }
    }

    // Test & Save SMTP Form Submission
    document.getElementById('smtp-form').onsubmit = async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btn-test-save-smtp');
      const btnText = document.getElementById('btn-save-smtp-text');

      try {
        btn.disabled = true;
        btnText.textContent = 'Verifying SMTP Connection...';

        const senderEmail = document.getElementById('smtp-field-email').value.trim();
        const smtpHost = document.getElementById('smtp-field-host').value.trim();
        const smtpPort = Number(document.getElementById('smtp-field-port').value) || 587;
        const smtpUser = document.getElementById('smtp-field-user').value.trim() || senderEmail;
        const smtpPass = document.getElementById('smtp-field-pass').value.trim();
        const dailyLimit = Number(document.getElementById('smtp-field-limit').value) || 30;

        const payload = {
          senderEmail,
          smtpHost,
          smtpPort,
          smtpUser,
          smtpPass,
          dailyLimit
        };

        const res = await fetch('/api/auto-campaign/add-sender', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (data.success) {
          displayToast(data.message || `SMTP Sender "${senderEmail}" verified & saved!`, 'success');
          closeModal();
          document.getElementById('smtp-form').reset();
          loadConnectedSenders();
        } else {
          displayToast(data.error || 'SMTP Verification failed. Please check host, port or password.', 'error');
        }

      } catch (err) {
        displayToast('Network error while testing SMTP connection.', 'error');
      } finally {
        btn.disabled = false;
        btnText.textContent = 'Test & Save SMTP';
      }
    };

    // Helper: Convert base64 VAPID key
    function base64ToUint8Array(base64String) {
      const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
      const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
      const rawData = window.atob(base64);
      const outputArray = new Uint8Array(rawData.length);
      for (let i = 0; i < rawData.length; ++i) {
        outputArray[i] = rawData.charCodeAt(i);
      }
      return outputArray;
    }

    // Init Push System
    async function initPushNotificationSystem() {
      const badge = document.getElementById('push-status-badge');
      const btn = document.getElementById('btn-enable-push');
      const btnText = document.getElementById('btn-push-text');

      if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
        badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30';
        badge.textContent = 'Push Notifications not supported on this browser';
        btn.disabled = true;
        btn.classList.add('opacity-50', 'cursor-not-allowed');
        return;
      }

      try {
        const registration = await navigator.serviceWorker.register('/auto-engine-sw.js');
        const existingSub = await registration.pushManager.getSubscription();

        if (existingSub) {
          activePushSubscription = existingSub;
          badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
          badge.textContent = '🟢 Mobile Push Active & Paired';
          btnText.textContent = 'Push Alerts Enabled';
          btn.classList.remove('from-cyan-500', 'to-blue-600');
          btn.classList.add('bg-slate-800', 'text-slate-300', 'border', 'border-slate-700');
        } else {
          badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-800 text-slate-300 border border-slate-700';
          badge.textContent = '⚪ Push Inactive (Click button to enable)';
        }
      } catch (err) {
        badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-800 text-slate-300 border border-slate-700';
        badge.textContent = 'Ready to Subscribe';
      }
    }

    // Subscribe to Push Alerts
    async function subscribeToPushAlerts() {
      const btn = document.getElementById('btn-enable-push');
      const btnText = document.getElementById('btn-push-text');
      const badge = document.getElementById('push-status-badge');

      try {
        btn.disabled = true;
        btnText.textContent = 'Requesting Permission...';

        const permission = await Notification.requestPermission();
        if (permission !== 'granted') {
          badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30';
          badge.textContent = 'Permission Denied in Browser Settings';
          displayToast('Notification permission denied. Please allow notifications in browser settings.', 'error');
          return;
        }

        btnText.textContent = 'Connecting Push Keys...';

        const keyRes = await fetch('/api/auto-engine/vapid-public-key');
        const keyData = await keyRes.json();
        if (!keyData.success || !keyData.publicKey) {
          throw new Error('VAPID public key unavailable from server.');
        }

        const registration = await navigator.serviceWorker.ready;
        const subscription = await registration.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: base64ToUint8Array(keyData.publicKey)
        });

        activePushSubscription = subscription;

        const saveRes = await fetch('/api/auto-engine/save-subscription', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            subscription: subscription.toJSON(),
            userAgent: navigator.userAgent
          })
        });

        const saveData = await saveRes.json();
        if (saveData.success) {
          badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
          badge.textContent = '🟢 Mobile Push Active & Paired';
          btnText.textContent = 'Push Alerts Enabled';
          displayToast('🔔 Success! Mobile Web Push is paired with your device lock screen.', 'success');
        } else {
          throw new Error(saveData.error || 'Failed to save subscription.');
        }

      } catch (err) {
        displayToast('Subscription error: ' + (err.message || 'Could not enable push alerts.'), 'error');
      } finally {
        btn.disabled = false;
      }
    }

    // Send Test Push Alert
    async function sendTestPushAlert() {
      const btn = document.getElementById('btn-test-push');
      try {
        btn.disabled = true;
        btn.innerHTML = '<span>⏳</span><span>Sending...</span>';

        const res = await fetch('/api/auto-engine/test-push', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            endpoint: activePushSubscription ? activePushSubscription.endpoint : undefined
          })
        });

        const data = await res.json();
        if (data.success) {
          displayToast('📨 Test push alert dispatched! Check your phone lock screen or notification tray.', 'success');
        } else {
          displayToast(data.error || 'Test alert dispatch failed.', 'error');
        }
      } catch (err) {
        displayToast('Network error while dispatching test push.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span>📨</span><span>Send Test Alert</span>';
      }
    }

    // Handle Campaign Submission to /api/auto-campaign/create-multi
    document.getElementById('auto-campaign-form').onsubmit = async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btn-submit-campaign');
      const btnText = document.getElementById('btn-submit-text');

      try {
        btn.disabled = true;
        btnText.textContent = 'Deploying Scalable 7-Day Cadence...';

        const niches = document.getElementById('field-niches').value;
        const targetCities = document.getElementById('field-cities').value;
        const dailyLimitPerSender = Number(document.getElementById('field-daily-limit').value) || 30;
        const portfolioUrl = document.getElementById('field-portfolio-url').value.trim();
        const servicePitch = document.getElementById('field-service-pitch').value.trim();

        const payload = {
          niches,
          targetCities,
          dailyLimitPerSender,
          portfolioUrl,
          servicePitch
        };

        const res = await fetch('/api/auto-campaign/create-multi', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (data.success) {
          displayToast('⚡ 7-Day Autonomous Engine successfully configured and deployed! Dispatches will begin according to sender quotas.', 'success');
          
          const streamList = document.getElementById('recent-stream-list');
          const firstNiche = niches.split(',')[0].trim();
          const firstCity = targetCities.split(',')[0].trim();
          
          const newRow = document.createElement('div');
          newRow.className = 'pt-2 first:pt-0 flex items-start justify-between gap-2';
          newRow.innerHTML = `
            <div class="min-w-0">
              <p class="font-bold text-cyan-300 truncate">${firstNiche} Pipeline</p>
              <p class="text-[10px] text-slate-400">${firstNiche} &bull; ${firstCity}</p>
            </div>
            <div class="text-right shrink-0">
              <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                Queued
              </span>
              <p class="text-[9px] text-slate-400 mt-0.5">Just now</p>
            </div>
          `;
          streamList.prepend(newRow);
        } else {
          displayToast(data.error || 'Failed to deploy campaign.', 'error');
        }

      } catch (err) {
        displayToast('Network error while deploying campaign.', 'error');
      } finally {
        btn.disabled = false;
        btnText.textContent = 'Start Scalable 7-Day Engine';
      }
    };

    // Event Listeners
    document.getElementById('btn-enable-push').onclick = subscribeToPushAlerts;
    document.getElementById('btn-test-push').onclick = sendTestPushAlert;
    document.getElementById('btn-refresh-senders').onclick = loadConnectedSenders;

    // Boot
    window.addEventListener('DOMContentLoaded', () => {
      initPushNotificationSystem();
      loadConnectedSenders();
    });
  </script>

</body>
</html>
