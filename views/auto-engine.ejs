              </div>
              <div class="text-right shrink-0">
                <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
                  Day 1 Pitch
                </span>
                <p class="text-[9px] text-slate-400 mt-0.5">Just now</p>
              </div>
            </div>

            <div class="pt-2 flex items-start justify-between gap-2">
              <div class="min-w-0">
                <p class="font-bold text-white truncate">Apex Smiles Dental</p>
                <p class="text-[10px] text-slate-400">Dentist &bull; Manchester</p>
              </div>
              <div class="text-right shrink-0">
                <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
                  Day 1 Pitch
                </span>
                <p class="text-[9px] text-slate-400 mt-0.5">4m ago</p>
              </div>
            </div>

            <div class="pt-2 flex items-start justify-between gap-2">
              <div class="min-w-0">
                <p class="font-bold text-white truncate">IronPeak Training Club</p>
                <p class="text-[10px] text-slate-400">Gym Coach &bull; New York</p>
              </div>
              <div class="text-right shrink-0">
                <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
                  Day 1 Pitch
                </span>
                <p class="text-[9px] text-slate-400 mt-0.5">12m ago</p>
              </div>
            </div>
          </div>

          <div class="p-2.5 rounded-xl bg-slate-950/70 border border-slate-800/80 text-[11px] text-slate-400 text-center flex items-center justify-center gap-1.5">
