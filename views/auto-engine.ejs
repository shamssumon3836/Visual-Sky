      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
        
        <div class="space-y-2 flex-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-black uppercase tracking-wider bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
